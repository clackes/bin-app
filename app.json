{
  "expo": {
    "name": "Bin",
    "slug": "bin-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0E10",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.clackes.bin"
    },
    "android": {
      "package": "com.clackes.bin",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Bin needs to see your photos and videos so you can choose what to keep and what to delete.",
          "savePhotosPermission": "Bin needs to modify your library to delete the items you discard.",
          "granularPermissions": ["photo", "video"]
        }
      ],
      "expo-video",
      "expo-image"
    ]
  }
}
